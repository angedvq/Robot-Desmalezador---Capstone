Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 60; 60
      Enabled: true
      Name: LaserScan
      Size (m): 0.04
      Style: Flat Squares
      Topic:
        Value: /scan
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: TreeMarkers
      Namespaces:
        arbol_lateral_disparo: true
        arbol_proximo_guia: true
        fov_disparo_lateral: true
        fov_guiado_amplio: true
      Topic:
        Value: /tree_markers
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: lidar_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 1.5708
      Name: TopDownOrtho
      Scale: 120
      Target Frame: lidar_link
      X: 0.4
      Y: -0.6
Window Geometry:
  Height: 800
  Width: 1000
